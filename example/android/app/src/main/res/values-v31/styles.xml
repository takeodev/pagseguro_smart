<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: tela de abertura do sistema com fundo branco e o ícone do app (logo do desenvolvedor),
         no lugar do ícone padrão do Flutter. Depois dela entra a splash animada em Flutter (ui/splash_screen.dart). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
